{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd site && bun install && bun sync.ts && bun run build",
  "outputDirectory": "site/dist",
  "installCommand": "bun install",
  "framework": null,
  "redirects": [
    {
      "source": "/authentication",
      "destination": "/faq#do-i-have-to-mock-a-connections-sign-in",
      "permanent": true
    }
  ]
}
