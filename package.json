{
  "name": "eve-mocks",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "In-process upstream mocks for eve agents: no servers, no ports, no mock branches in connection code.",
  "license": "Apache-2.0",
  "bin": {
    "eve-mocks": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./preload": "./src/preload.ts"
  },
  "files": [
    "src",
    "docs"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link:self": "mkdir -p node_modules && ln -sfn .. node_modules/eve-mocks",
    "example": "bun run link:self && cd example && ../src/cli.ts -- bun check.ts --mocks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openapi-sampler": "^1.7.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzmyr/eve-mocks.git"
  },
  "author": "Moritz Meyer",
  "engines": {
    "node": ">=22.15"
  }
}
