{
  "name": "eve-mocks",
  "version": "0.2.0",
  "type": "module",
  "description": "Mocks for eve agents",
  "license": "Apache-2.0",
  "bin": {
    "eve-mocks": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "default": "./dist/evals/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "dev": "cd site && bun sync.ts && blume dev",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "link:self": "mkdir -p node_modules && ln -sfn .. node_modules/eve-mocks",
    "example": "bun run build && bun run link:self && cd example && ../src/cli.ts -- bun check.ts --mocks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openapi-sampler": "^1.7.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24",
    "blume": "^1.7.3",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzmyr/eve-mocks.git"
  },
  "author": "Moritz Meyer",
  "engines": {
    "node": ">=22.15"
  },
  "homepage": "https://eve-mocks.vercel.app",
  "bugs": {
    "url": "https://github.com/mrzmyr/eve-mocks/issues"
  },
  "keywords": [
    "eve",
    "mocks",
    "mcp",
    "openapi",
    "testing",
    "agents"
  ]
}
